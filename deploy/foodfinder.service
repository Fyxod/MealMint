[Unit]
Description=Foodfinder personal food assistant
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=foodfinder
Group=foodfinder
WorkingDirectory=/opt/foodfinder/current
EnvironmentFile=/etc/foodfinder/foodfinder.env
Environment=NODE_ENV=production
Environment=HOME=/home/foodfinder
Environment=CODEX_HOME=/home/foodfinder/.codex
Environment=PATH=/opt/foodfinder/runtime/bin:/usr/bin:/bin
ExecStart=/opt/foodfinder/runtime/bin/node dist/server/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/foodfinder /home/foodfinder/.codex
MemoryHigh=350M
MemoryMax=500M
MemorySwapMax=1G
TasksMax=128
[Install]
WantedBy=multi-user.target
