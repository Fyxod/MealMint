[Unit]
Description=Personal Swiggy food assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=swiggy
Group=swiggy
WorkingDirectory=/opt/swiggy-mcp
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/swiggy
ExecStart=/usr/local/bin/node dist/server/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
