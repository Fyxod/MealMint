# Node 24+. Copy to .env; keep secrets local.
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:5173
AGENT_PROVIDER=codex
# User requires this model/effort for Codex-auth + MCP agent validation.
CODEX_MODEL=gpt-6-luna
CODEX_EFFORT=max
CODEX_BIN=codex
SWIGGY_MODE=mock
SWIGGY_MCP_URL=https://mcp.swiggy.com/food
SWIGGY_REDIRECT_URI=http://localhost:3000/auth/swiggy/callback
# Required for hosted use, including when a reverse proxy fronts localhost.
APP_ACCESS_TOKEN=
# Optional Telegram channel. Create a bot via @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=
# Enable live cart comparisons only after documenting staging schema/unit checks.
SWIGGY_LIVE_QUOTES_VALIDATED=false
# Set to the actual item ID field accepted by update_food_cart in staging.
SWIGGY_CART_ITEM_ID_FIELD=
