# Node 24+. Copy to .env; keep secrets local.
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:5173
AGENT_PROVIDER=codex
# Leave empty to discover the signed-in account's default model.
CODEX_MODEL=
CODEX_EFFORT=medium
CODEX_BIN=codex
SWIGGY_MODE=mock
SWIGGY_MCP_URL=https://mcp.swiggy.com/food
SWIGGY_REDIRECT_URI=http://localhost:3000/auth/swiggy/callback
# When HOST is public, this is mandatory. Send as Bearer token or use web sign-in.
APP_ACCESS_TOKEN=
# Optional Telegram channel. Create a bot via @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=
# Optional public callback relay (deferred until Azure access).
OAUTH_RELAY_URL=
OAUTH_RELAY_SECRET=
